{
  "name": "skitrip-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local --port 8787",
    "emulators": "firebase emulators:start --only auth --project demo-skitrip",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply skitrip --local",
    "demo:e2e": "node scripts/demo-e2e.mjs",
    "collect:snow": "tsx tools/collectors/snow.ts",
    "collect:offers": "tsx tools/collectors/offers.ts",
    "e2e": "playwright test",
    "check:online": "tsx tools/online-check.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  }
}
