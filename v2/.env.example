# Configuración pública del SDK web de Firebase (no son secretos: el navegador las necesita).
# Copiar a .env.production.local antes de `npm run build` para desplegar. En desarrollo no hace falta:
# la app usa el emulador de Auth automáticamente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
# 1 fuerza el emulador; 0 fuerza Firebase real. Vacío: emulador en `vite dev`, real en build.
VITE_USE_AUTH_EMULATOR=
